# ==============================================================================
# SRI BASAVESHWARA & CO — AGRIBOS ERP
# ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env (for local dev) or configure these in your production host.
# NEVER commit your active .env file containing real passwords to version control.

# Core Settings
DEBUG=True
SECRET_KEY=django-insecure-change-this-in-production-use-a-strong-random-key
ALLOWED_HOSTS=localhost,127.0.0.1,.onrender.com
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,https://*.onrender.com
DJANGO_SETTINGS_MODULE=expense_tracking_core.settings.development

# Database Configuration (MySQL 8.x / TiDB / RDS / PostgreSQL)
DB_ENGINE=django.db.backends.mysql
DB_NAME=expense_tracking_db
DB_USER=root
DB_PASSWORD=your_database_password_here
DB_HOST=127.0.0.1
DB_PORT=3306
DB_CONN_MAX_AGE=600

# Optional Cloud Database URL (Auto-detected if provided on Render / Cloud platforms)
# DATABASE_URL=mysql://user:pass@host:3306/dbname
# DATABASE_URL=postgres://user:pass@host:5432/dbname

# Localization
TIME_ZONE=Asia/Kolkata
USE_TZ=True

# Production Security & SSL (When DEBUG=False)
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000

# Email & 500 Error Alerts (Optional)
# Format for ADMINS: AdminName:admin@example.com;Owner:owner@example.com
ADMINS=
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@example.com
