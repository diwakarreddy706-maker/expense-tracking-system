# ==============================================================================
# EXPENSE TRACKING & MANAGEMENT SYSTEM - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# Security
SECRET_KEY=django-insecure-change-this-in-production-use-a-strong-random-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database Configuration (MySQL 8.x)
DB_ENGINE=django.db.backends.mysql
DB_NAME=expense_tracking_db
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_HOST=127.0.0.1
DB_PORT=3306

# Localization
TIME_ZONE=Asia/Kolkata
USE_TZ=True

# Application Settings
DJANGO_SETTINGS_MODULE=expense_tracking_core.settings.development
