# ==============================================================================
# Expense Tracking & Management System - Production Environment Template
# Copy this file to .env on the production server and fill in real values.
# NEVER commit the active .env or .env.production file to version control.
# ==============================================================================

# Core Django Settings
DJANGO_SETTINGS_MODULE=expense_tracking_core.settings.production
SECRET_KEY=generate-a-cryptographically-secure-random-key-at-least-50-chars-long
DEBUG=False
ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# Production Database (MySQL 8.0)
DB_NAME=expense_tracking_db
DB_USER=expense_user
DB_PASSWORD=replace_with_strong_production_db_password
DB_HOST=127.0.0.1
DB_PORT=3306
DB_CONN_MAX_AGE=600

# Docker Compose Specific (Root password for MySQL initialization)
MYSQL_ROOT_PASSWORD=replace_with_strong_root_password

# SSL & Security Policy
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000

# Gunicorn WSGI Server Settings
GUNICORN_BIND=127.0.0.1:8000
GUNICORN_WORKERS=4
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=60
GUNICORN_KEEPALIVE=5
GUNICORN_MAX_REQUESTS=1000
GUNICORN_MAX_REQUESTS_JITTER=100
GUNICORN_ACCESS_LOG=/var/log/expense_tracking/access.log
GUNICORN_ERROR_LOG=/var/log/expense_tracking/error.log
GUNICORN_LOG_LEVEL=info

# Production Email & Error Notifications (500 Error Alerts)
# Format for ADMINS: Name:email@domain.com;Name2:email2@domain.com
ADMINS=DevOps:admin@yourdomain.com;Owner:owner@yourdomain.com
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.yourmailprovider.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=notifications@yourdomain.com
EMAIL_HOST_PASSWORD=replace_with_smtp_app_password
DEFAULT_FROM_EMAIL=notifications@yourdomain.com
SERVER_EMAIL=notifications@yourdomain.com

# Automated Backup Settings
BACKUP_DIR=/var/backups/expense_tracking
RETENTION_DAYS=30
